# Copy to .env (never commit .env). All values are read by backend/app/config.py.

# ---- LLM providers (all free tiers, no card). Leave a key empty to skip that provider. ----
# Primary. Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Backup 1. Groq: https://console.groq.com/keys (small per-minute token limits; best for short calls)
GROQ_API_KEY=
# Backup 2. Mistral "Experiment" plan: https://console.mistral.ai/api-keys (phone verification)
MISTRAL_API_KEY=
# Backup 3. OpenRouter free models (":free" ids, ~50 requests/day): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: web search for source discovery (app.tavily.com, free 1,000 searches/month, no card).
# Without it Ritam still finds sources for every card and scheme in its verified catalogue.
TAVILY_API_KEY=

# Optional overrides (JSON). Order = fallback order. Format "provider:model".
# LLM_EXTRACT_CHAIN=["gemini:gemini-3.5-flash-lite","mistral:mistral-small-latest"]
# LLM_REASON_CHAIN=["gemini:gemini-3.5-flash","groq:openai/gpt-oss-120b"]
# LLM_RPM={"gemini": 10, "groq": 30, "mistral": 50, "openrouter": 20}

# Local defaults match docker-compose.yml. In production, set these in the host's env settings.
DATABASE_URL=postgresql+asyncpg://ritam:ritam@localhost:5432/ritam
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ritam-local-dev
# Aura HTTPS Query API (port 443): fallback where port 7687 is blocked
NEO4J_QUERY_API_URL=

LLM_RPM={"gemini": 10, "groq": 30, "mistral": 50, "openrouter": 20}
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
